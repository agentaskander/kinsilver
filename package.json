{
  "name": "kinsilver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "build": "npm run build:prod",
    "build:raw": "vite build",
    "build:dev": "vite build --outDir dist-dev",
    "build:stage": "vite build --outDir dist-stage && node scripts/audit-stage-build.mjs",
    "build:prod": "vite build --outDir dist-prod && node scripts/sanitize-prod-build.mjs && node scripts/audit-prod-build.mjs",
    "assert:prod": "node scripts/assert-prod-output.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 5193 --strictPort",
    "preview:prod": "vite preview --host 127.0.0.1 --port 5194 --strictPort --outDir dist-prod",
    "publish:prod": "npm run build:prod",
    "demo": "npm run build && npm run preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.15.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.14",
    "tailwindcss": "3.4.17",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "tailwindcss": "3.4.17"
  }
}
